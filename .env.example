# ── Required ──────────────────────────────────────────
BOT_TOKEN=""                       # Telegram bot token from @BotFather
OPENAI_API_TOKEN=""                # OpenAI API key for GPT summarization
REPLICATE_API_TOKEN=""             # Replicate API key for voice transcription

# ── Optional ──────────────────────────────────────────
DATABASE_URL="./tmp/db"            # PGlite DB path (local file-based by default)
ADMIN_USERS=""                     # Comma-separated Telegram user IDs: "42069,123456789"
ALLOWED_GROUPS=""                  # Comma-separated Telegram group IDs: "-1002147456812,-42069"

# ⚠️  The original .env tokens (BOT_TOKEN, REPLICATE_API_TOKEN, OPENAI_API_TOKEN)
#    were committed to git history and should be considered compromised.
#    They have been rotated. Generate fresh tokens from their respective services.
